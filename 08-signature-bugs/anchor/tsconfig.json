{
	"compilerOptions": {
		"types": [
			"mocha",
			"chai",
			"node"
		],
		"typeRoots": [
			"../../node_modules/@types"
		],
		"lib": [
			"es2015"
		],
		"module": "commonjs",
		"target": "es6",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"strict": true,
		"noEmit": true
	},
	"include": [
		"tests/**/*",
		"target/types/**/*"
	]
}